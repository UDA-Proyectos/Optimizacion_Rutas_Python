# --- Base de datos ---
POSTGRES_USER=vrp_user
POSTGRES_PASSWORD=cambiar_esto
POSTGRES_DB=vrp_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://vrp_user:cambiar_esto@localhost:5432/vrp_db

# --- Autenticación ---
JWT_SECRET_KEY=generar_con_python_-c_"import secrets;print(secrets.token_urlsafe(64))"
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# --- Login con Google (opcional) ---
# Sin estas dos variables el botón "Continuar con Google" no aparece.
# Se crean en Google Cloud Console → APIs y servicios → Credenciales (ver README).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Tiene que coincidir exacto con una URI de redirección autorizada en Google.
# En desarrollo la API corre en :8000; en producción puede quedar vacía
# (se usa FRONTEND_URL + /api/v1/auth/google/callback).
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# --- Entorno ---
ENTORNO=desarrollo
FRONTEND_URL=http://localhost:5174

# --- Ruteo (OSRM / solver) ---
# Por defecto el servidor demo público (anda sin preparar nada, pero tiene
# rate-limiting). Para usar tu propio OSRM (ver "OSRM propio" en el README):
#   OSRM_BASE_URL=http://localhost:5001
OSRM_BASE_URL=http://router.project-osrm.org
# Puerto del contenedor OSRM propio (docker compose --profile osrm up -d osrm)
OSRM_PORT=5001
SOLVER_TIME_LIMIT_SEGUNDOS=5

# --- Geocoding (Nominatim) ---
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
